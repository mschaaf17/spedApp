{
  "name": "inclusion",
  "version": "2.0.0",
  "private": true,
  "description": "Mobile classroom support and student self-advocacy",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "mobile",
    "api"
  ],
  "scripts": {
    "start": "npm run start --workspace=inclusion-api",
    "dev": "concurrently -k -n api,web \"npm run dev --workspace=inclusion-api\" \"npm run dev --workspace=inclusion-mobile\"",
    "dev:demo": "npm run dev --workspace=inclusion-mobile",
    "build": "npm run build --workspace=inclusion-mobile",
    "test": "node --test shared/test/*.test.mjs api/test/*.test.mjs",
    "bootstrap": "npm run bootstrap --workspace=inclusion-api",
    "migrate:legacy": "node --env-file-if-exists=.env api/scripts/migrate-legacy.mjs",
    "legacy:start": "node server/server.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mschaaf17/spedApp"
  }
}
