{
  "manifest_version": 3,
  "name": "Inclusion — Ask for Support",
  "version": "2.0.0",
  "description": "Privately request your assigned classroom accommodations without leaving your schoolwork.",
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "My classroom supports"
  },
  "icons": { "128": "icon-128.png" }
}
