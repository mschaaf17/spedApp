# Copy to .env; never commit actual credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/inclusion-student-app
JWT_SECRET=
APP_ORIGINS=http://localhost:5173
PORT=3001
# Set only to the number of trusted reverse proxies in your deployment.
TRUST_PROXY=0
# Optional, comma-separated approved Chrome extension IDs.
CHROME_EXTENSION_IDS=
# Optional AI drafting; all three fields are required to enable external calls.
AI_DRAFTS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional Web Push; generate with npx web-push generate-vapid-keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Used only by the bootstrap script, never exposed to the browser.
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ROLE=admin
BOOTSTRAP_NAME=
